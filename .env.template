# =============================================================================
# SIP Insight Lab — Environment Variables Template
# =============================================================================
# INSTRUCTIONS:
#   1. Copy this file to `.env` in the project root.
#   2. Fill in your actual credentials — NEVER commit `.env` to version control.
#   3. This template (.env.template) is safe to commit; it contains NO secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# APIFY API (Web & Social Scrapers)
# Obtain token from: https://console.apify.com/account/integrations
# -----------------------------------------------------------------------------
APIFY_API_TOKEN=your_apify_api_token_here



# -----------------------------------------------------------------------------
# GOOGLE PLAY STORE
# Uses google-play-scraper with target package ID and polite request delay.
# -----------------------------------------------------------------------------
PLAY_STORE_TARGET_APP_ID=com.nextbillion.groww
PLAY_STORE_REQUEST_DELAY_SECONDS=2

# -----------------------------------------------------------------------------
# YOUTUBE DATA API v3
# Obtain from: https://console.cloud.google.com/apis/credentials
# Enable: YouTube Data API v3
# -----------------------------------------------------------------------------
YOUTUBE_API_KEY=your_youtube_api_key_here

# -----------------------------------------------------------------------------
# GROQ API — Classification & Synthesis Engine
# Obtain from: https://console.groq.com/keys
# Supported models: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
# -----------------------------------------------------------------------------
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# -----------------------------------------------------------------------------
# DATABASE
# Supported backends: sqlite | postgresql
# For local development, sqlite is recommended.
# -----------------------------------------------------------------------------
DB_BACKEND=sqlite
DB_PATH=./data/sip_insight_lab.db

# -----------------------------------------------------------------------------
# APPLICATION CONFIG
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
DATA_DIR=./data
TAXONOMY_PATH=./taxonomy/taxonomy_v1.yaml
GOLDEN_SET_DIR=./golden_set
OUTPUTS_DIR=./outputs
PROMPTS_DIR=./src/prompts
